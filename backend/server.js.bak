app.post('/add-friend', authenticate, (req, res) => {
    const { userId, friendUsername } = req.body;
    db.query('SELECT id FROM users WHERE username = ?', [friendUsername], (err, results) => {
        if (results.length === 0) return res.status(404).json({ error: 'User not found.' });
        const fId = results[0].id;
        if (fId == userId) return res.status(400).json({ error: "You can't add yourself." });
        db.query('SELECT * FROM friends WHERE (user_id = ? AND friend_id = ?) OR (user_id = ? AND friend_id = ?)',
            [userId, fId, fId, userId], (err, ex) => {
                if (ex.length > 0) return res.status(400).json({ error: 'Request already exists.' });
                db.query('INSERT INTO friends (user_id, friend_id, status) VALUES (?, ?, "pending")', [userId, fId], (err2, result2) => {
                    // Notification for receiver
                    db.query('SELECT username FROM users WHERE id = ?', [userId], (err3, senderRes) => {
                        const senderName = senderRes[0]?.username;
                        db.query('INSERT INTO notifications (user_id, type, title, message, related_id) VALUES (?, "friend_request", ?, ?, ?)',
                            [fId, `Friend request from ${senderName}`, `${senderName} wants to be your friend!`, userId]);
                    });
                    
                    res.json({ message: 'Friend request sent!' });
                });
            }
        );
    });
});


app.get('/friends/:userId', authenticate, (req, res) => {
    const uid = req.params.userId;
    const sql = `SELECT u.id, u.username, u.profile_pic, u.bio
                 FROM friends f
                 JOIN users u ON u.id = CASE WHEN f.user_id = ? THEN f.friend_id ELSE f.user_id END
                 WHERE (f.user_id = ? OR f.friend_id = ?) AND f.status = 'accepted';
    db.query(sql, [uid, uid, uid], (err, results) => res.json(results));
};

app.get('/friend-requests/:userId', authenticate, (req, res) => {
    const sql = `SELECT f.id as requestId, u.username, u.profile_pic FROM users u 
                 JOIN friends f ON f.user_id = u.id WHERE f.friend_id = ? AND f.status = 'pending'`;
    db.query(sql, [req.params.userId], (err, results) => res.json(results));
});

app.post('/accept-friend', authenticate, (req, res) => {
    db.query('UPDATE friends SET status = "accepted" WHERE id = ?', [req.body.requestId], (err) => {
        // Notify sender
        db.query('SELECT user_id, friend_id FROM friends WHERE id = ?', [req.body.requestId], (err2, friendRow) => {
            if (friendRow.length > 0) {
                const { user_id, friend_id } = friendRow[0];
                db.query('SELECT username FROM users WHERE id = ?', [friend_id], (err3, userRes) => {
                    db.query('INSERT INTO notifications (user_id, type, title, message) VALUES (?, "friend_accepted", ?, ?)',
                        [user_id, `${userRes[0]?.username} accepted your friend request!`, 'You are now friends. Start chatting!']);
                    checkAndGrantAchievement(friend_id, 'social_butterfly');
                });
            }
        });
        res.json({ message: 'Friend request accepted.' });
    });
});

app.delete('/friend/:friendshipId', authenticate, (req, res) => {
    db.query('DELETE FROM friends WHERE id = ?', [req.params.friendshipId], () => res.json({ success: true }));
});

