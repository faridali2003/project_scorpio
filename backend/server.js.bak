app.get('/notifications/:userId', authenticate, authorizeSelf, (req, res) => {
    db.query('SELECT * FROM notifications WHERE user_id = ? ORDER BY created_at DESC LIMIT 50', [req.params.userId], (err, results) => {
        res.json(results);
    });
});

app.post('/notifications/read', authenticate, (req, res) => {
    db.query('UPDATE notifications SET is_read = 1 WHERE user_id = ?', [req.body.userId], () => res.json({ success: true }));
});

app.delete('/notifications/:id', authenticate, (req, res) => {
    db.query('DELETE FROM notifications WHERE id = ?', [req.params.id], () => res.json({ success: true }));
});

