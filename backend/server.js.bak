app.post('/register', async (req, res) => {
    const { username, email, password, securityAnswer } = req.body;
    if (!username || !email || !password) return res.status(400).json({ error: 'All fields required.' });
    try {
        const hashed = await bcrypt.hash(password, 10);
        db.query(
            'INSERT INTO users (username, email, password, security_answer) VALUES (?, ?, ?, ?)',
            [username, email, hashed, securityAnswer],
            (err, result) => {
                if (err) return res.status(409).json({ error: 'Username or email already exists.' });
                const userId = result.insertId;
                // Welcome notification
                db.query('INSERT INTO notifications (user_id, type, title, message) VALUES (?, "system", ?, ?)',
                    [userId, 'Welcome to Scorpio! ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â°ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¸ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â½ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â®', 'Your account has been created. Start exploring the store!']);
                const token = jwt.sign({ id: userId, username }, config.jwtSecret, { expiresIn: '7d' });
                res.status(201).json({ message: 'Account created!', token, id: userId, username, balance: 0, profile_pic: null, email, theme: 'dark' });
            }
        );
    } catch (err) {
        res.status(500).json({ error: 'Server error.' });
    }
});

app.post('/login', (req, res) => {
    const { email, password } = req.body;
    db.query('SELECT * FROM users WHERE email = ?', [email], async (err, results) => {
        if (err) return res.status(500).json({ error: 'Server error.' });
        if (results.length === 0) return res.status(404).json({ error: 'Account not found.' });
        const user = results[0];
        const match = await bcrypt.compare(password, user.password);
        if (!match) return res.status(401).json({ error: 'Incorrect password.' });
        const token = jwt.sign({ id: user.id, username: user.username }, config.jwtSecret, { expiresIn: '7d' });
        res.json({ token, id: user.id, username: user.username, balance: user.balance, profile_pic: user.profile_pic, email: user.email, bio: user.bio, theme: user.theme });
    });
});

app.post('/reset-password', (req, res) => {
    const { email, securityAnswer, newPassword } = req.body;
    db.query('SELECT * FROM users WHERE email = ? AND security_answer = ?', [email, securityAnswer], async (err, results) => {
        if (results.length === 0) return res.status(401).json({ error: 'Invalid email or security answer.' });
        const hashed = await bcrypt.hash(newPassword, 10);
        db.query('UPDATE users SET password = ? WHERE email = ?', [hashed, email], () => res.json({ message: 'Password reset successfully.' }));
    });
});

