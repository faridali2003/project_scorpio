app.get('/achievements/:userId', (req, res) => {
    db.query('SELECT * FROM achievements WHERE user_id = ? ORDER BY unlocked_at DESC', [req.params.userId], (err, results) => {
        res.json({ unlocked: results, all: ACHIEVEMENTS_DEF });
