app.get('/messages/:roomId', authenticate, (req, res) => {
    const sql = `SELECT m.*, u.username as author, u.profile_pic
                 FROM messages m JOIN users u ON m.sender_id = u.id
                 WHERE room_id = ? ORDER BY sent_at ASC`;
    db.query(sql, [req.params.roomId], (err, results) => {
        if (err) return res.status(500).json({ error: err });
        const formatted = results.map(msg => ({
            ...msg,
            text: msg.message_text,
            time: new Date(msg.sent_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        }));
        res.json(formatted);
    });
});

// Mark messages as read
app.post('/messages/read', authenticate, (req, res) => {
    db.query('UPDATE messages SET is_read = 1 WHERE room_id = ? AND receiver_id = ?',
        [req.body.roomId, req.body.userId], () => res.json({ success: true }));
});

