app.get('/library/:userId', authenticate, authorizeSelf, (req, res) => {
    db.query('SELECT * FROM library WHERE user_id = ? ORDER BY purchased_at DESC', [req.params.userId], (err, results) => {
        if (err) return res.status(500).json({ error: err });
        res.json(results);
    });
});

app.post('/purchase', authenticate, (req, res) => {
    const { userId, gameName, price } = req.body;
    db.query('SELECT balance FROM users WHERE id = ?', [userId], (err, results) => {
        if (err || !results.length) return res.status(500).json({ error: 'User not found.' });
        const currentBal = parseFloat(results[0].balance);
        if (currentBal < price) return res.status(400).json({ error: 'Insufficient funds.' });
        const newBalance = +(currentBal - price).toFixed(2);
        db.query('UPDATE users SET balance = ? WHERE id = ?', [newBalance, userId]);
        db.query('INSERT INTO library (user_id, game_name) VALUES (?, ?)', [userId, gameName], (err2, result2) => {
            if (err2) return res.status(409).json({ error: 'Already in library.' });
            // Remove from wishlist if present
            db.query('DELETE FROM wishlist WHERE user_id = ? AND game_name = ?', [userId, gameName]);
            // Purchase notification
            db.query('INSERT INTO notifications (user_id, type, title, message) VALUES (?, "purchase", ?, ?)',
                [userId, `${gameName} added to library!`, `You purchased ${gameName} for $${price}. Enjoy!`]);
            // Check achievements
            db.query('SELECT COUNT(*) as cnt FROM library WHERE user_id = ?', [userId], (err3, countResult) => {
                const count = countResult[0].cnt;
                checkAndGrantAchievement(userId, 'first_purchase');
                if (count >= 5) checkAndGrantAchievement(userId, 'collector_5');
            });
            res.json({ success: true, newBalance });
        });
    });
});

app.post('/redeem-code', authenticate, (req, res) => {
    const { userId, code } = req.body;
    db.query('SELECT * FROM gift_cards WHERE code = ?', [code], (err, results) => {
        if (results.length === 0) return res.status(404).json({ error: 'Invalid code.' });
        if (results[0].is_used) return res.status(400).json({ error: 'Code already used.' });
        const amountToAdd = parseFloat(results[0].amount);
        db.query('UPDATE gift_cards SET is_used = 1, used_by = ? WHERE id = ?', [userId, results[0].id], () => {
            db.query('UPDATE users SET balance = balance + ? WHERE id = ?', [amountToAdd, userId], () => {
                db.query('SELECT balance FROM users WHERE id = ?', [userId], (err2, bal) => {
                    const newBalance = parseFloat(bal[0].balance);
                    db.query('INSERT INTO notifications (user_id, type, title, message) VALUES (?, "wallet", ?, ?)',
                        [userId, `$${amountToAdd} added to wallet!`, `Gift card redeemed successfully.`]);
                    if (newBalance >= 100) checkAndGrantAchievement(userId, 'wallet_100');
                    res.json({ success: true, amountAdded: amountToAdd, newBalance });
                });
            });
        });
    });
});

