app.get('/wishlist/:userId', authenticate, authorizeSelf, (req, res) => {
    db.query('SELECT * FROM wishlist WHERE user_id = ? ORDER BY added_at DESC', [req.params.userId], (err, results) => {
        res.json(results);
    });
});

app.post('/wishlist/toggle', authenticate, (req, res) => {
    const { userId, gameName } = req.body;
    db.query('SELECT id FROM wishlist WHERE user_id = ? AND game_name = ?', [userId, gameName], (err, results) => {
        if (results.length > 0) {
            db.query('DELETE FROM wishlist WHERE user_id = ? AND game_name = ?', [userId, gameName], () =>
                res.json({ added: false })
            );
        } else {
            db.query('INSERT INTO wishlist (user_id, game_name) VALUES (?, ?)', [userId, gameName], () => {
                db.query('SELECT COUNT(*) as cnt FROM wishlist WHERE user_id = ?', [userId], (err2, countRes) => {
                    if (countRes[0].cnt >= 10) checkAndGrantAchievement(userId, 'wishlist_10');
                });
                res.json({ added: true });
            });
        }
    });
});

