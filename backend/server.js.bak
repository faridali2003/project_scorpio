app.get('/reviews', (req, res) => {
    const sql = `SELECT r.*, u.username as author, u.profile_pic FROM reviews r
                 JOIN users u ON r.user_id = u.id
                 WHERE r.game_name = ? ORDER BY r.created_at DESC`;
    const gameName = req.query.game;
    if (!gameName) return res.status(400).json({ error: 'game query parameter required' });
    db.query(sql, [gameName], (err, results) => {
        if (err) return res.status(500).json({ error: err });
        res.json(results);
    });
});

app.get('/my-review/:userId', authenticate, authorizeSelf, (req, res) => {
    const gameName = req.query.game;
    if (!gameName) return res.status(400).json({ error: 'game query parameter required' });
    db.query('SELECT * FROM reviews WHERE user_id = ? AND game_name = ?',
        [req.params.userId, gameName],
        (err, results) => res.json(results[0] || null)
    );
});
});

app.post('/review', authenticate, (req, res) => {
    const { userId, gameName, rating, reviewText } = req.body;
    // Check user owns the game
    db.query('SELECT id FROM library WHERE user_id = ? AND game_name = ?', [userId, gameName], (err, owned) => {
        if (!owned.length) return res.status(403).json({ error: 'You must own the game to review it.' });
        const sql = `INSERT INTO reviews (user_id, game_name, rating, review_text) VALUES (?, ?, ?, ?)
                     ON DUPLICATE KEY UPDATE rating = VALUES(rating), review_text = VALUES(review_text), created_at = CURRENT_TIMESTAMP`;
        db.query(sql, [userId, gameName, rating, reviewText], (err2) => {
            if (err2) return res.status(500).json({ error: 'Could not save review.' });
            checkAndGrantAchievement(userId, 'reviewer');
            res.json({ success: true });
        });
    });
});

app.delete('/review/:userId', authenticate, authorizeSelf, (req, res) => {
    const gameName = req.query.game;
    if (!gameName) return res.status(400).json({ error: 'game query parameter required' });
    db.query('DELETE FROM reviews WHERE user_id = ? AND game_name = ?',
        [req.params.userId, gameName],
        () => res.json({ success: true })
    );
});
});

