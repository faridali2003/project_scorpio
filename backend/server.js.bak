app.get('/search-users', authenticate, (req, res) => {
    const query = `%${req.query.q}%`;
    const sql = `SELECT id, username, profile_pic, bio FROM users WHERE username LIKE ? LIMIT 10`;
    db.query(sql, [query], (err, results) => res.json(results));
});

app.get('/profile/:userId', (req, res) => {
    const sql = `SELECT u.id, u.username as author, u.profile_pic, u.bio, u.created_at,
                 (SELECT COUNT(*) FROM library WHERE user_id = u.id) as game_count,
                 (SELECT COUNT(*) FROM friends WHERE (user_id = u.id OR friend_id = u.id) AND status = 'accepted') as friend_count,
                 (SELECT COUNT(*) FROM reviews WHERE user_id = u.id) as review_count,
                 (SELECT COUNT(*) FROM achievements WHERE user_id = u.id) as achievement_count
                 FROM users u WHERE u.id = ?`;
    db.query(sql, [req.params.userId], (err, results) => {
        if (!results.length) return res.status(404).json({ error: 'User not found.' });
        res.json(results[0]);
    });
});

